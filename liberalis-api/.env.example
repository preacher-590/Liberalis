# =======================================================
# Liberalis API — Configuration d'environnement
# Copiez ce fichier en .env puis :
#   php artisan key:generate
#   php artisan migrate
# =======================================================

APP_NAME=Liberalis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------------------------------------
# Base de donnees MySQL
# Creez d'abord la base : CREATE DATABASE liberalis;
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=liberalis
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -------------------------------------------------------
# Sanctum — autorise le frontend React (Vite) en local
# -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------
# Mail — rappels de rendez-vous par email
# En local : MAIL_MAILER=log (emails ecrits dans
# storage/logs/laravel.log, aucun compte externe requis).
# En production : passez a smtp avec vos identifiants
# Brevo (300 emails/jour gratuits) ou autre fournisseur.
#
# Les rappels sont envoyes par la commande planifiee
# appointments:send-reminders (voir routes/console.php).
# En production, lancez le scheduler :
#   php artisan schedule:work
# -------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@liberalis.com"
MAIL_FROM_NAME="${APP_NAME}"

# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=votre-identifiant-brevo
# MAIL_PASSWORD=votre-cle-smtp-brevo
# MAIL_ENCRYPTION=tls
